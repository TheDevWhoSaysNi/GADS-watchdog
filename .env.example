# GADS Watchdog — copy to `.env` and fill only what you use.
# Blank variables are ignored. Every filled notification channel gets the alert.

# --- GADS hub ---
# demo | live
GADS_MODE=
# Official default is often :10000. Many systemd installs use --port 8080.
# Discover: scripts/discover-host.sh or systemctl cat gads-hub.service
GADS_URL=http://127.0.0.1:10000
# Dedicated hub user is better than your personal admin login.
GADS_USERNAME=admin
GADS_PASSWORD=
GADS_AUTH_ENABLED=true
# Origin-bound JWTs. Leave blank to use GADS_URL.
GADS_ORIGIN=
GADS_WORKSPACE_ID=

# --- Watchdog ---
WATCHDOG_POLL_SECONDS=8
# Floor is 15. Set above your provider-restart time so hourly bounces stay quiet.
WATCHDOG_DOWN_GRACE_SECONDS=60
# After a provider restart looks finished, wait this long before paging again.
WATCHDOG_PROVIDER_SETTLE_SECONDS=60
WATCHDOG_RECOVER_NOTIFY=true
WATCHDOG_COLLECTOR_TOKEN=

# --- ntfy (phone push, also used by the guided setup) ---
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# --- Telegram ---
# 1. Talk to @BotFather, create a bot, paste the token.
# 2. Message the bot, then get your chat id from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Discord ---
# Server settings → Integrations → Webhooks → New webhook → Copy URL
DISCORD_WEBHOOK_URL=

# --- Slack ---
# Incoming Webhooks app → webhook URL
SLACK_WEBHOOK_URL=

# --- Mattermost ---
MATTERMOST_WEBHOOK_URL=

# --- Microsoft Teams ---
# Channel → Connectors → Incoming Webhook
TEAMS_WEBHOOK_URL=

# --- Pushover ---
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=

# --- Gotify ---
GOTIFY_URL=
GOTIFY_TOKEN=

# --- Generic POST { source: "gads-watchdog", event } ---
WEBHOOK_URL=
